# Без входа история недоступна.
GET {{base_url}}/imports
HTTP 401

GET {{base_url}}/auth/csrf
HTTP 200
[Captures]
csrf: jsonpath "$.csrf_token"
POST {{base_url}}/auth/login
X-CSRF-Token: {{csrf}}
{
    "username": "stage02_alice",
    "password": "secret_1"
}
HTTP 200

GET {{base_url}}/auth/csrf
HTTP 200
[Captures]
csrf: jsonpath "$.csrf_token"
# Все три статуса, счётчик только у успешной операции.
GET {{base_url}}/imports
HTTP 200
[Asserts]
header "Cache-Control" contains "no-store"
jsonpath "$.total_items" == 3
jsonpath "$.items" count == 3
jsonpath "$.items[0].username" == "stage02_alice"
jsonpath "$.items[1].username" == "stage02_alice"
jsonpath "$.items[2].username" == "stage02_alice"
jsonpath "$.items[0].id" == 1
jsonpath "$.items[0].status" == "SUCCESS"
jsonpath "$.items[0].added_count" == 3
jsonpath "$.items[1].status" == "IN_PROGRESS"
jsonpath "$.items[1].added_count" == null
jsonpath "$.items[2].status" == "FAILED"
jsonpath "$.items[2].added_count" == null
jsonpath "$.items[0].password_hash" not exists
jsonpath "$.items[0].user" not exists
GET {{base_url}}/imports?user_id=2&username=stage02_admin&admin=true
HTTP 200
[Asserts]
jsonpath "$.total_items" == 3
jsonpath "$.items[0].username" == "stage02_alice"
jsonpath "$.items[1].username" == "stage02_alice"
jsonpath "$.items[2].username" == "stage02_alice"
GET {{base_url}}/imports?page=2&page_size=2&sort_order=asc
HTTP 200
[Asserts]
jsonpath "$.total_items" == 3
jsonpath "$.items" count == 1
jsonpath "$.items[0].id" == 3
GET {{base_url}}/imports?page=0
HTTP 400

GET {{base_url}}/imports?sort_by=username
HTTP 400

POST {{base_url}}/auth/logout
X-CSRF-Token: {{csrf}}
HTTP 204

GET {{base_url}}/auth/csrf
HTTP 200
[Captures]
csrf: jsonpath "$.csrf_token"
POST {{base_url}}/auth/login
X-CSRF-Token: {{csrf}}
{
    "username": "stage02_bob",
    "password": "secret_1"
}
HTTP 200

GET {{base_url}}/auth/csrf
HTTP 200
[Captures]
csrf: jsonpath "$.csrf_token"
GET {{base_url}}/imports
HTTP 200
[Asserts]
jsonpath "$.total_items" == 1
jsonpath "$.items" count == 1
jsonpath "$.items[0].username" == "stage02_bob"
jsonpath "$.items[0].id" == 4
jsonpath "$.items[0].added_count" == 2
POST {{base_url}}/auth/logout
X-CSRF-Token: {{csrf}}
HTTP 204

GET {{base_url}}/auth/csrf
HTTP 200
[Captures]
csrf: jsonpath "$.csrf_token"
POST {{base_url}}/auth/login
X-CSRF-Token: {{csrf}}
{
    "username": "stage02_admin",
    "password": "secret_1"
}
HTTP 200

GET {{base_url}}/auth/csrf
HTTP 200
[Captures]
csrf: jsonpath "$.csrf_token"
GET {{base_url}}/imports?sort_order=desc
HTTP 200
[Asserts]
jsonpath "$.total_items" == 5
jsonpath "$.items" count == 5
jsonpath "$.items[0].id" == 5
jsonpath "$.items[1].id" == 4
jsonpath "$.items[2].id" == 3
jsonpath "$.items[3].id" == 2
jsonpath "$.items[4].id" == 1
jsonpath "$.items[0].username" == "stage02_admin"
jsonpath "$.items[1].username" == "stage02_bob"
jsonpath "$.items[2].username" == "stage02_alice"
jsonpath "$.items[3].username" == "stage02_alice"
jsonpath "$.items[4].username" == "stage02_alice"
POST {{base_url}}/auth/logout
X-CSRF-Token: {{csrf}}
HTTP 204

GET {{base_url}}/imports
HTTP 401

