# Подготовка через настоящий API регистрации; сервер должен смотреть в тестовую БД.
GET {{base_url}}/auth/csrf
HTTP 200
[Captures]
csrf: jsonpath "$.csrf_token"
POST {{base_url}}/auth/register
X-CSRF-Token: {{csrf}}
{
    "username": "stage02_alice",
    "password": "secret_1",
    "admin": true,
    "is_admin": true
}
HTTP 201

POST {{base_url}}/auth/register
X-CSRF-Token: {{csrf}}
{
    "username": "stage02_bob",
    "password": "secret_1",
    "admin": true,
    "is_admin": true
}
HTTP 201

POST {{base_url}}/auth/register
X-CSRF-Token: {{csrf}}
{
    "username": "stage02_admin",
    "password": "secret_1",
    "admin": true,
    "is_admin": true
}
HTTP 201

